# Backlink Hive Environment Variables
# Copy this to .env and fill in the values

# Google Cloud Project
GCP_PROJECT_ID=andon-backlink-hive-prod
STORAGE_TYPE=FILE  # or FIRESTORE

# LLM Keys
GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=sk-... (Legacy/Backup)

# Cloudflare (for DNS/CDN management)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# Social Keys (Optional)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Browser Automation (Optional)
BROWSER_USE_API_KEY=

# External APIs (Optional)
API_NINJAS_KEY=

# Hive Security
HIVE_SECRET_KEY=generate_a_uuid_here
