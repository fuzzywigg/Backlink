"""
ENS RESCUE SCRIPT
Attempts to transfer 'smtp.eth' from Compromised Wallet -> Safe Wallet
"""
from web3 import Web3
import os
import sys

# CONFIGURATION
# ---------------------------------------------------------
# The SAFE wallet where you want to send the ENS
SAFE_WALLET = "0xF74b240A115449Ec0e0D55Cda3623E48A6e29011"

# The COMPROMISED Private Key (You must input this, I will NOT hardcode it)
# Set it as env var 'RESCUE_PK' or paste when prompted
PK = os.getenv("RESCUE_PK")

# ENS Registry Address (Mainnet)
ENS_REGISTRY = "0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e"
# Base Node for smtp.eth (Namehash of 'smtp.eth')
# calculated via namehash('smtp.eth')
# 'eth' node: 0x93cdeb708b7545dc668eb9280176169d1c33cfd8ed6f04690a0bcc88a93fc4ae
# keccak256(node, keccak256('smtp'))
SMTP_NODE = "0x5352695c02604859e97f26f6eb949987814b752df423b49c00b55694c965e648"

def rescue():
    print("🚨 ENS RESCUE PROTOCOL INITIATED 🚨")
    
    global PK
    if not PK:
        PK = input("PASTE COMPROMISED PRIVATE KEY (Input hidden? No, be careful): ").strip()
    
    w3 = Web3(Web3.HTTPProvider("https://eth.llamarpc.com"))
    
    if not w3.is_connected():
        print("❌ Failed to connect to Ethereum Mainnet")
        return

    account = w3.eth.account.from_key(PK)
    print(f"Authenticated as: {account.address}")
    
    # 1. Check ETH Balance for Gas
    bal = w3.from_wei(w3.eth.get_balance(account.address), 'ether')
    print(f"Gas Balance: {bal} ETH")
    
    if bal < 0.002:
        print("❌ INSUFFICIENT ETH FOR GAS via L1. You need ~$5-10 ETH to execute the transfer.")
        print("Aborting because sending gas to this wallet might just get drained by a bot.")
        return

    # 2. Prepare Transaction
    # setOwner(node, owner)
    # Function Token: 0x5b0fc9c3
    contract = w3.eth.contract(address=ENS_REGISTRY, abi=[{
        "constant": False,
        "inputs": [
            {"name": "node", "type": "bytes32"},
            {"name": "owner", "type": "address"}
        ],
        "name": "setOwner",
        "outputs": [],
        "type": "function"
    }])
    
    print(f"Attempting to Transfer Ownership of node {SMTP_NODE[:10]}...")
    print(f"To Safe Wallet: {SAFE_WALLET}")
    
    # Construct Tx
    tx = contract.functions.setOwner(
        SMTP_NODE,
        SAFE_WALLET
    ).build_transaction({
        'from': account.address,
        'nonce': w3.eth.get_transaction_count(account.address),
        'gas': 100000, # Hardcoded high gas limit
        'maxFeePerGas': w3.to_wei('50', 'gwei'), # Aggressive Gas
        'maxPriorityFeePerGas': w3.to_wei('5', 'gwei'),
    })
    
    signed_tx = w3.eth.account.sign_transaction(tx, PK)
    
    print("🚀 BROADCASTING RESCUE TX...")
    try:
        tx_hash = w3.eth.send_raw_transaction(signed_tx.raw_transaction)
        print(f"✅ TRANSACTION SENT: https://etherscan.io/tx/{w3.to_hex(tx_hash)}")
        print("Check Etherscan immediately.")
    except Exception as e:
        print(f"❌ Transaction Failed: {e}")

if __name__ == "__main__":
    rescue()
