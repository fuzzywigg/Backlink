"""
ENS RESCUE SNIPER (The "All-In" Protocol)
-----------------------------------------------
This script pre-calculates the rescue transaction and listens for INCOMING ETH.
The moment ETH arrives, it broadcasts the rescue transaction instantly.

ELI5 LOGIC:
1. We prepare the "Move ENS Name" letter (transaction) and sign it.
2. We wait by the mailbox (mempool).
3. You throw money (ETH) at the mailbox.
4. We instantly drop the letter in.
"""
from web3 import Web3
import time
import os
import sys

# --- CONFIGURATION ---
# The Safe Wallet to receive the ENS
SAFE_WALLET = Web3.to_checksum_address("0x9d276f15c8c090453437fcdba911fbb8d98d996d")

# The Compromised Wallet (just for verification)
COMPROMISED_ADDR = "0x7aa67bFefb4FDafc779ff1843c6e3b3DfA0Af0a8"

# ENS Details for 'smtp.eth'
ENS_REGISTRY = "0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e"
SMTP_NODE = "0x5352695c02604859e97f26f6eb949987814b752df423b49c00b55694c965e648"

# RPC URL (Using a public one, can swap if you have a faster private one like Alchemy)
RPC_URL = "https://eth.llamarpc.com"
# ---------------------

def run_sniper():
    print("\n⚡ ENS RESCUE SNIPER ⚡")
    print("-------------------------")
    
    # 1. Setup Connection
    w3 = Web3(Web3.HTTPProvider(RPC_URL))
    if not w3.is_connected():
        print("❌ Error: Could not connect to Ethereum Network.")
        return

    # 2. Secure Key Input
    pk = os.getenv("RESCUE_PK")
    if not pk:
        print("Enter the COMPROMISED Private Key (Input will be hidden/clean):")
        pk = input("Key: ").strip()
    
    # Verify Account
    account = w3.eth.account.from_key(pk)
    if account.address.lower() != COMPROMISED_ADDR.lower():
        print(f"⚠️ WARNING: Key derived {account.address}, expected {COMPROMISED_ADDR}")
        confirm = input("Continue anyway? (y/n): ")
        if confirm.lower() != 'y': return

    print(f"✅ Authenticated: {account.address}")
    
    # 3. Strategy Calculation (Gas)
    # We need to be aggressive. We want to pay HIGH GAS to beat any drainer bot.
    # Current Base Fee + Priority
    latest_block = w3.eth.get_block("latest")
    base_fee = latest_block['baseFeePerGas']
    
    # STRATEGY: 
    # MaxPriority = 5 Gwei (Generous tip to miner)
    # MaxFee = BaseFee * 2 (To be safe against spikes) + Tip
    priority_fee = w3.to_wei(5, 'gwei')
    max_fee = (base_fee * 2) + priority_fee
    
    gas_limit = 120000 # Safety margin for setOwner
    
    total_cost_wei = gas_limit * max_fee
    total_cost_eth = w3.from_wei(total_cost_wei, 'ether')
    
    # Add a safety buffer for the transfer cost itself (0.005 ETH buffer)
    REQUIRED_ETH = float(total_cost_eth)
    RECOMMENDED_SEND = 0.015  # Send $40-50 to be safe
    
    print("\n--- PRE-FLIGHT CHECK ---")
    print(f"Target:      Sending 'smtp.eth' -> {SAFE_WALLET}")
    print(f"Gas Strategy: Aggressive ({w3.from_wei(max_fee, 'gwei'):.0f} Gwei max)")
    print(f"Est Cost:    {REQUIRED_ETH:.5f} ETH")
    print("\n👉 ACTION REQUIRED:")
    print(f"Prepare to send EXACTLY [ {RECOMMENDED_SEND} ETH ] to {COMPROMISED_ADDR}")
    print("DO NOT SEND YET. Wait for 'LISTENING' status.")
    print("------------------------")
    
    input("Press ENTER to Build Transaction & Start Listening...")

    # 4. Pre-Build Transaction
    contract = w3.eth.contract(address=ENS_REGISTRY, abi=[{
        "constant": False, "inputs": [{"name": "node", "type": "bytes32"}, {"name": "owner", "type": "address"}],
        "name": "setOwner", "outputs": [], "type": "function"
    }])
    
    nonce = w3.eth.get_transaction_count(account.address)
    
    # Construct the Tx
    tx = contract.functions.setOwner(
        SMTP_NODE,
        SAFE_WALLET
    ).build_transaction({
        'from': account.address,
        'nonce': nonce,
        'gas': gas_limit,
        'maxFeePerGas': max_fee,
        'maxPriorityFeePerGas': priority_fee,
        'chainId': 1
    })
    
    # Sign it NOW (So we process 0ms when money arrives)
    signed_tx = w3.eth.account.sign_transaction(tx, pk)
    print("✅ Transaction Signed & Armed in Memory.")

    # 5. The Sniper Loop
    print(f"\n📡 LISTENING FOR FUNDS on {COMPROMISED_ADDR}...")
    print(f"Waiting for balance > {total_cost_eth:.5f} ETH...")
    
    while True:
        try:
            # Quick balance check
            bal = w3.eth.get_balance(account.address)
            
            if bal >= total_cost_wei:
                print(f"\n💰 FUNDS DETECTED: {w3.from_wei(bal, 'ether')} ETH")
                print("🚀 FIRING RESCUE TRANSACTION...")
                
                try:
                    tx_hash = w3.eth.send_raw_transaction(signed_tx.raw_transaction)
                    print(f"\n✅ SUCCESS! Tx Hash: https://etherscan.io/tx/{w3.to_hex(tx_hash)}")
                    print("Check Etherscan immediately!")
                    break
                except Exception as e:
                    print(f"❌ BROADCAST FAILED: {e}")
                    # If nonce is wrong or gas spiked, we might loop? 
                    # For safety, let's break, unless it's a 'replacement fee too low' 
                    # But for this simple script, break & debug is safer than spamming.
                    break
            
            # Sleep tiny amount to not get rate limited by free RPC
            time.sleep(0.5)
            # Print a dot every 10 loops to show life? Nah, keep clean.
            
        except KeyboardInterrupt:
            print("\n🛑 Sniper stopped by user.")
            break
        except Exception as e:
            # Network blip? Ignore and retry
            print(f"Connection blip: {e}")
            time.sleep(1)

if __name__ == "__main__":
    run_sniper()
